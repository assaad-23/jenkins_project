pipeline {
  agent any

  options { ansiColor('xterm') }

  stages {

    stage('Check Python') {
      steps {
        bat '''
          echo ===== PATH =====
          echo %PATH%
          where python
          where py
          py -V
        '''
      }
    }

    stage('Setup') {
        steps {
            bat '''
            rem Clean any old/bad venv
            if exist "venv" rmdir /s /q "venv"

            rem Prefer Python 3.13; fallback to 3.x
            py -3.13 -V >nul 2>&1
            if errorlevel 1 (
                echo Python 3.13 not found; falling back to default 3.x
                set "PY_CMD=py -3"
            ) else (
                set "PY_CMD=py -3.13"
            )

            rem Create fresh venv with real Python (not WindowsApps)
            %PY_CMD% -m venv "venv"
            "venv\\Scripts\\python" -c "import sys; print('VENV PY:', sys.executable)"

            rem Install deps via venv python
            "venv\\Scripts\\python" -m pip install --upgrade pip
            "venv\\Scripts\\python" -m pip install -r requirements.txt
            '''
        }
    }



    stage('Lint') {
      steps {
        bat '"venv\\Scripts\\python" -m flake8 app.py'
      }
    }

    stage('Test') {
      steps {
        bat '''
          set "PYTHONPATH=%CD%"
          "venv\\Scripts\\python" -m pytest -q --junitxml=pytest-report.xml
        '''
      }
    }

    stage('Coverage') {
      steps {
        bat '''
          set "PYTHONPATH=%CD%"
          "venv\\Scripts\\python" -m coverage run -m pytest
          "venv\\Scripts\\python" -m coverage html
          "venv\\Scripts\\python" -m coverage report
        '''
      }
    }

    stage('Security Scan') {
      steps {
        bat '"venv\\Scripts\\python" -m bandit -r . -x venv,tests,__pycache__,node_modules -f html -o bandit-report.html'
      }
    }

    stage('Deploy') {
      steps {
        bat '''
          echo Deploying application...
          powershell -NoProfile -Command "Compress-Archive -Path app.py -DestinationPath build-artifact.zip -Force"
          echo Artifact built at: %cd%\\build-artifact.zip
        '''
      }
    }
  }

  post {
    always {
      // Record tests even if empty so the stage doesn't fail
      junit allowEmptyResults: true, testResults: 'pytest-report.xml'

      script {
        if (fileExists('htmlcov/index.html')) {
          publishHTML(target: [
            reportName: 'Coverage Report',
            reportDir: 'htmlcov',
            reportFiles: 'index.html',
            keepAll: true,
            alwaysLinkToLastBuild: true
          ])
        }
        if (fileExists('bandit-report.html')) {
          publishHTML(target: [
            reportName: 'Bandit Security Report',
            reportDir: '.',
            reportFiles: 'bandit-report.html',
            keepAll: true,
            alwaysLinkToLastBuild: true
          ])
        }
      }

      cleanWs()
    }
  }
}
